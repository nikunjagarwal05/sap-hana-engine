# PostgreSQL Landing Zone & Metadata Database Config
POSTGRES_DB=sap_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Secret Key (Must be at least 32 bytes)
JWT_SECRET=YOUR_JWT_SECRET_KEY_MINIMUM_32_BYTES_LONG

# SAP HANA Trial Instance & OData Credentials (Optional Overrides)
SAP_HANA_JDBC_URL=jdbc:sap://hana-cloud.trial.sap:443/?encrypt=true
SAP_HANA_USER=SYSTEM
SAP_HANA_PASSWORD=YOUR_PASSWORD_HERE
SAP_API_KEY=YOUR_SAP_API_KEY_HERE
